# Local-only by default. Existing environment variables take precedence.
AUTO_PROMOTION_LIVE_WRITES=0
AP_DB=var/auto-promotion.db
# Optional API bearer token; generated privately in var/operator.key if omitted.
# AP_API_TOKEN=

# Bundled backends are the default. See docs/platforms.md for local login.
# Optional private profile directory; use forward slashes on Windows.
# AP_ACCOUNTS_DIR=C:/path/to/private/accounts
# Optional legacy mode, only if original backend projects still exist:
# AP_TELEGRAM_BACKEND=legacy
# AUTO_PROMOTION_WORKSPACE=C:/path/to/promotion-backends
# AP_TELEGRAM_PYTHON=C:/path/to/telegram-mcp/.venv/Scripts/python.exe
# AP_TELEGRAM_MCP_URL=http://127.0.0.1:8765/mcp

# Set to auto-promotion only after checking the local account identity.
# These settings never replace the task's two exact approvals.
AP_TELEGRAM_OWNER=
AP_REDDIT_OWNER=
AP_INSTAGRAM_OWNER=
AP_X_OWNER=
AP_DISCORD_OWNER=
AP_TIKTOK_OWNER=

# Optional draft-only JSON service; never called by the sender.
# POST {model,instructions,profile,opportunity} -> {text,title}.
# HTTPS required outside localhost. Keep keys out of profiles and content imports.
AP_DRAFT_ENDPOINT=
AP_DRAFT_API_KEY=
AP_DRAFT_MODEL=

# Independent Hala broadcasts. This never enables social-platform execution.
AP_ALERTS_ENABLED=0
AP_ALERTS_SOURCE=Auto Promotion
AP_ALERTS_POLL_SECONDS=30
# Automatic delivery is fixed to one platform-count summary every three hours.
AP_ALERTS_TIMEOUT_SECONDS=10
# ALERT_RELAY_KEY=
# Or a private file; only ALERT_RELAY_KEY is read from this file:
# AP_ALERTS_ENV_FILE=C:/path/to/private/.env

# Persistent platform/connection pools (also CLI serve's default).
AP_EXECUTION_MODE=pooled
# Optional subset for this executor, e.g. telegram.mtproto,x.edge,x.tabbit.
# AP_EXECUTOR_POOLS=
# Cloud configuration is generated privately in var/cloud-node.env by cloud-bootstrap.
# See docs/cloudflare-execution.md. Never put platform session credentials in the cloud snapshot.
