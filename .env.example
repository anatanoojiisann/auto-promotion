# Local-only by default. Existing environment variables take precedence.
AUTO_PROMOTION_LIVE_WRITES=0
AP_DB=var/auto-promotion.db
# Optional API bearer token; generated privately in var/operator.key if omitted.
# AP_API_TOKEN=

# Optional live backends; see docs/platforms.md.
# AUTO_PROMOTION_WORKSPACE=/srv/promotion-backends
AP_TELEGRAM_MCP_URL=http://127.0.0.1:8765/mcp
REDDIT_BROWSER_CDP_URL=http://127.0.0.1:9223
X_ACTION_BASE_URL=http://127.0.0.1:3000
# X_ACTION_TOKEN=
# AP_INSTAGRAM_URL=https://localhost:8090
AP_INSTAGRAM_ACCOUNT=

# Each backend uses its own .venv/bin/python by default.
# Override when the backend has a different runtime location:
# AP_X_PYTHON=/srv/promotion-backends/x-engagement/.venv/bin/python

# Set to auto-promotion only after handing over the account from legacy workers.
# These settings never replace the task's two exact approvals.
AP_TELEGRAM_OWNER=
AP_REDDIT_OWNER=
AP_INSTAGRAM_OWNER=
AP_X_OWNER=
