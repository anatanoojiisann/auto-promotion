{
  "name": "auto-promotion-control",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "WORKSPACE_ID": "auto-promotion",
    "FALLBACK_NODE_ID": "windows-primary",
    "FALLBACK_STORE_ID": "feea453950ce4caebed3e167ff8598f5",
    "LOCAL_CHANNEL_UNTIL": "1792252800",
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTROL", "class_name": "WorkspaceCoordinator" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceCoordinator"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
